# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Not used until later phases (cron / push). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Base URL used in invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 5: bill scanning (server-only, used by /api/scan)
GEMINI_API_KEY=
GROQ_API_KEY=
