# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API (URL) and API Keys (Secret key).
# Server-only: the browser never talks to Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Signs login cookies. 32+ random characters: npm run session:secret
SESSION_SECRET=

# Base URL used in invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push public key and the shared secret for the notify Edge Function (npm run push:keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=

# Bill scanning (server-only, used by /api/scan)
GEMINI_API_KEY=
GROQ_API_KEY=
