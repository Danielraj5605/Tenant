{
  "name": "tenant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:link": "supabase link --project-ref vpfeenjpkzrspkhxmhdd",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --linked > lib/supabase/types.ts",
    "engine:sync": "node scripts/sync-engine.mjs",
    "functions:check": "npm run engine:sync && node scripts/check-functions.mjs",
    "push:keys": "node scripts/make-push-keys.mjs",
    "functions:deploy": "npm run functions:check && supabase functions deploy daily --no-verify-jwt && supabase functions deploy notify --no-verify-jwt",
    "functions:secrets": "supabase secrets set --env-file supabase/.env.functions",
    "session:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "seed:sample": "esbuild scripts/seed-sample.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/seed-sample.mjs && node node_modules/.cache/seed-sample.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
